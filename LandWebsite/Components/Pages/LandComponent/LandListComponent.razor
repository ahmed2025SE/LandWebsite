@page "/LandListComponent"
@using LandWebsite.Data.Entites
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject ILandServices _landDesignServices
<h3>LandListComponent</h3>

<MudTable Items="Lands" Hover="true" Loading="@_loading" LoadingProgressColor="Color.Info">
    <ToolBarContent>
        <MudSpacer />
        <MudButton Color="Color.Primary"
        Variant="Variant.Filled"
        StartIcon="@Icons.Material.Filled.Add"
                   @onclick="NavigateToAddLand">Add</MudButton>

    </ToolBarContent>
    <HeaderContent>
        <MudTh>معرف الارض</MudTh>
        <MudTh>المساحه</MudTh>
        <MudTh>السعر</MudTh>
        <MudTh>الموقع</MudTh>
        <MudTh>معرف صاحب العقار</MudTh>
        <MudTh>العمليات </MudTh>


    </HeaderContent>
    <RowTemplate>

        <MudTd DataLabel="معرف الارض">@context.landId</MudTd>
        <MudTd DataLabel="المساحه">@context.area</MudTd>
        <MudTd DataLabel="السعر">@context.price</MudTd>
        <MudTd DataLabel="الموقع">@context.location</MudTd>
        <MudTd DataLabel="معرف صاحب العقار">@context.OwnerId</MudTd>
        <MudTd>
            <MudButton Color="Color.Primary"
            Variant="Variant.Filled"
            StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="()=>NavigateToEditLand(context)" />


            <MudButton Color="Color.Error"
            Variant="Variant.Filled"
            StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="()=>DeleteLand(context)" />


        </MudTd>


    </RowTemplate>
</MudTable>
@code {
    private bool _loading = false;
    public List<Land> Lands { get; set; } = new List<Land>();

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        await Task.Delay(2000);
        Lands = await _landDesignServices.GetLands();
        _loading = false;
    }

    public void NavigateToAddLand()
    {
        NavigationManager.NavigateTo("");
    }


    public void NavigateToEditLand(Land land)
    {
        NavigationManager.NavigateTo($"/{land.landId}");
    }



    public async Task DeleteLand(Land land)
    {
        await _landDesignServices.DeleteAsync(land);
        Lands.Remove(land);
       
    }

}
