@page "/OwnerListComponent"
@using LandWebsite.Components.Pages.OwnerComponents
@using LandWebsite.Data.Entites
@rendermode InteractiveServer
@inject NavigationManager NavigationManager




<MudTable Items="Owners" Hover="true" Loading="@_loading" LoadingProgressColor="Color.Info">
    <ToolBarContent>
        <MudSpacer />
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Add"
                   @onclick="NavigateToAddOwner">Add</MudButton>

    </ToolBarContent>
    <HeaderContent>
        <MudTh>معرف صاحب العقار</MudTh>
        <MudTh>اسم صاحب العقار</MudTh>
        <MudTh>الايميل</MudTh>
        <MudTh>رقم الهاتف</MudTh>
        <MudTh>العمليات </MudTh>
        

    </HeaderContent>
    <RowTemplate>

        <MudTd DataLabel="معرف صاحب العقار">@context.ownerId</MudTd>
        <MudTd DataLabel="اسم صاحب العقار">@context.ownerName</MudTd>
        <MudTd DataLabel="الايميل">@context.email</MudTd>
        <MudTd DataLabel="رقم الهاتف">@context.phone</MudTd>
        <MudTd>
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Edit" />


            <MudButton Color="Color.Error"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Delete"
                       />


        </MudTd>
      

    </RowTemplate>
</MudTable>



@code {

    private bool _loading = false;
    public List<Owner> Owners { get; set; } = new List<Owner>();
    OwnerDesignServices _ownerDesignServices; /* هنا عرفت متغير نوعه كلاس سيرفز*/

    protected override async Task OnInitializedAsync()  /* عند تحميل بشكل غير متزامن نفذ كود بتاعك.... هذا الداله تشتغل عند تحميل الصفحه*/
    {
        _ownerDesignServices = new OwnerDesignServices();/* هنا انشئت كائن من كلاس السرفيز*/
        _loading = true;
        await Task.Delay(2000);
        Owners = _ownerDesignServices.GetOwners();
        _loading = false;
    }
    public void NavigateToAddOwner()
    {
        NavigationManager.NavigateTo("OwnerEdit");
    }


}